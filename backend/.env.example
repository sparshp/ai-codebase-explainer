# Copy to .env — do NOT commit real secrets

PORT=3001
NODE_ENV=development

# Production free-tier: set true so ingestion worker runs inside the API process
RUN_WORKER=false

# Postgres (local docker-compose uses port 5433)
DATABASE_URL=postgresql://dev:dev@localhost:5433/codeexplainer

# Redis
REDIS_URL=redis://localhost:6379

# Chroma
CHROMA_URL=http://localhost:8000

# Frontend URL (production: your Vercel URL)
FRONTEND_URL=http://localhost:5173

# Embeddings: ollama (local) | huggingface (cloud)
EMBED_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
HF_API_KEY=
# Must be available on HF Inference Providers (nomic often returns 400 on serverless)
HF_EMBED_MODEL=sentence-transformers/all-mpnet-base-v2
EMBED_DIM=768
EMBED_DIM=768

# LLM: ollama (local) | groq (cloud — recommended for deploy)
LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=llama3.2
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.1-8b-instant

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# GitHub — optional; required for private repos & higher rate limits
GITHUB_TOKEN=

# Optional tuning
ENABLE_RERANK=false
MAX_EXPANDED_QUERIES=1
MAX_CONTEXT_TOKENS=2500
